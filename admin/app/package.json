{
  "name": "summer-admin",
  "version": "0.1.0",
  "description": "Summer Admin - panel de control del launcher",
  "main": "main.js",
  "scripts": {
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "studio.summer.admin",
    "productName": "Summer Admin",
    "win": { "target": "portable", "icon": "bundle/icon.ico" },
    "files": ["main.js", "preload.js", "setup.html", "bundle/summer-admin.js", "bundle/panel.html", "bundle/icon.ico", "package.json"],
    "extraResources": [{ "from": "bundle/root", "to": "root" }]
  }
}
